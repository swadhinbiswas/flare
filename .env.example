# FLARE environment template. Copy to .env for the CLI scripts and to .dev.vars
# for the Worker runtime (`pnpm dev`). Both files are gitignored.
#
# Rules of thumb:
#   .env        what the CLI scripts read: mailbox login, Turso, provider keys
#   .dev.vars   what the Worker reads at runtime: the same provider keys and secrets
# Keep the provider values in sync between the two files.

# ---------------------------------------------------------------------------
# Mailbox login
# ---------------------------------------------------------------------------
# Used by `pnpm create-admin` when no arguments are passed. The password is
# hashed with PBKDF2 and only the hash is stored in Turso; this value is never
# read by the Worker at runtime.
FLARE_ADMIN_EMAIL="you@example.com"
FLARE_ADMIN_PASSWORD="choose-a-long-password"
FLARE_ADMIN_NAME="Your Name"

# ---------------------------------------------------------------------------
# Resend (sending + receiving)
# ---------------------------------------------------------------------------
# API key with sending access, and the signing secret from the webhook detail
# page. The secret is `whsec_` followed by base64.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="

# ---------------------------------------------------------------------------
# Maileroo (optional, adds a second provider)
# ---------------------------------------------------------------------------
# Sending key from the dashboard, and the webhook shared secret used to verify
# the x-maileroo-signature header. Leave blank if you only use Resend.
MAILEROO_API_KEY=""
MAILEROO_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# SMTP relay credentials (optional, not read by FLARE)
# ---------------------------------------------------------------------------
# FLARE sends and receives through provider HTTP APIs, so it does not use these.
# They are handy if you also point another mail client at the same domain, or
# if you later add an SMTP provider. Resend: username is `resend` and the
# password is your API key. Maileroo: both come from the dashboard.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Turso (database)
# ---------------------------------------------------------------------------
# Hosted: libsql://<db>.turso.io with a token from `turso db tokens create`.
# Local:  http://127.0.0.1:8080 from `turso dev`, with an empty token.
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-32-plus-random-bytes"
