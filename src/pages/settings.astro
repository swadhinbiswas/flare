---
import { env } from 'cloudflare:workers';
import AppShell from '@/layouts/AppShell.astro';
import SettingsActions from '@/components/settings/SettingsActions';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Separator } from '@/components/ui/separator';
import { getMailProvider } from '@/lib/providers';
import { accountSummaries, getActiveAccount } from '@/lib/accounts';
import ProviderTools from '@/components/settings/ProviderTools';
import ProfileForm from '@/components/settings/ProfileForm';

const user = Astro.locals.user!;
const account = getActiveAccount(Astro.request.headers.get('cookie'));
const accounts = accountSummaries();
const provider = getMailProvider(account);
const webhookUrl = new URL(`/api/webhooks/${account.provider}/${account.id}`, env.PUBLIC_APP_URL).toString();
const inboundDomain = account.inboundDomain ?? env.RESEND_INBOUND_DOMAIN;

let metrics: Record<string, number> | null = null;
let metricsError: string | null = null;
try {
  metrics = (await provider.getMetrics(7)).totals;
} catch (error) {
  metricsError = error instanceof Error ? error.message : 'Metrics are unavailable.';
}

type DomainInfo = { name: string; status: string; region?: string; sending?: string; receiving?: string };
type WebhookInfo = { endpoint: string; events: string[] | null };

let domain: DomainInfo | null = null;
let webhooks: WebhookInfo[] | null = null;
let resendError: string | null = null;

try {
  const domains = await provider.listDomains();
  const match = domains.find((item) => item.name === inboundDomain);
  if (match) {
    domain = {
      name: match.name,
      status: match.status,
      region: match.region,
      sending: match.sending,
      receiving: match.receiving,
    };
  }
} catch (error) {
  resendError = error instanceof Error ? error.message : 'Could not reach the mail provider.';
}

try {
  webhooks = (await provider.listWebhooks()).map((item) => ({ endpoint: item.endpoint, events: item.events }));
} catch {
  webhooks = null;
}

const webhookRegistered = webhooks?.some((item) => item.endpoint === webhookUrl) ?? null;
const tursoHost = (() => {
  try {
    return new URL(env.TURSO_DATABASE_URL.replace(/^libsql:\/\//, 'https://')).host;
  } catch {
    return env.TURSO_DATABASE_URL;
  }
})();

// Resend reports capabilities as 'enabled' | 'disabled'; the domain itself has
// a separate status ('pending' | 'verified' | ...).
const sendingEnabled = domain?.sending === 'enabled';
const receivingEnabled = domain?.receiving === 'enabled';
const domainHealthy = domain?.status === 'verified' && sendingEnabled && receivingEnabled;
---

<AppShell title="Settings · FLARE" bodyClass="overflow-y-auto">
  <div class="mx-auto max-w-3xl px-5 py-10">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <a href="/" class="text-muted-foreground hover:text-foreground text-xs">← Back to inbox</a>
        <h1 class="mt-1 text-xl font-semibold tracking-tight">Settings</h1>
        <p class="text-muted-foreground text-sm">Mailbox, delivery and infrastructure status.</p>
      </div>
      <SettingsActions client:load user={user} webhookUrl={webhookUrl} />
    </header>

    {!domainHealthy ? (
      <Alert variant="warning" className="mb-5">
        <AlertTitle>Domain not ready for sending and receiving</AlertTitle>
        <AlertDescription>
          {resendError
            ? `${provider.label} could not be reached: ${resendError}`
            : !domain
              ? `${inboundDomain} is not present in your Resend account. Add it and verify the MX/DKIM/SPF records to receive mail.`
              : domain.status !== 'verified'
                ? `${inboundDomain} is "${domain.status}". Inbound mail will not arrive until Resend shows it as verified.`
                : `${inboundDomain} is verified but receiving is ${domain.receiving ?? 'unknown'}; add the MX record Resend shows in the dashboard to enable inbound mail.`}
        </AlertDescription>
      </Alert>
    ) : null}

    {webhookRegistered === false ? (
      <Alert variant="warning" className="mb-5">
        <AlertTitle>Webhook not registered</AlertTitle>
        <AlertDescription>
          No Resend webhook points at <code class="text-xs">{webhookUrl}</code>. Inbound mail and delivery status
          updates need it — add it under Webhooks in the Resend dashboard.
        </AlertDescription>
      </Alert>
    ) : null}

    <div class="grid gap-5">
      <Card>
        <CardHeader>
          <CardTitle>Profile</CardTitle>
          <CardDescription>
            How you appear in the app and in the From header of outgoing mail.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <ProfileForm client:load user={user} />
        </CardContent>
      </Card>

      <Card id="accounts">
        <CardHeader>
          <CardTitle>Mail accounts</CardTitle>
          <CardDescription>
            Each account is a provider plus a From address. Accounts come from the
            <code class="text-xs">MAIL_ACCOUNTS</code> variable; credentials stay in Wrangler secrets.
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-3 text-sm">
          {accounts.map((item) => (
            <div class="flex items-center justify-between gap-4">
              <span>
                <span class="block font-medium">
                  {item.label}
                  {item.id === account.id ? ' · active' : ''}
                </span>
                <span class="text-muted-foreground block text-xs">
                  {item.provider}
                  {item.fromEmail ? ` · from ${item.fromEmail}` : ''}
                  {item.inboundDomain ? ` · ${item.inboundDomain}` : ''}
                </span>
              </span>
              <Badge variant={item.configured ? 'success' : 'warning'}>
                {item.configured ? 'configured' : 'missing API key'}
              </Badge>
            </div>
          ))}
          <p class="text-muted-foreground text-xs">
            Add an account by extending <code class="text-xs">MAIL_ACCOUNTS</code> with an id, a provider
            (resend or maileroo), a From address and the names of its credential variables. Switch accounts from the
            sidebar. Each account gets its own webhook endpoint, shown below.
          </p>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Account</CardTitle>
          <CardDescription>The single admin user for this mailbox.</CardDescription>
        </CardHeader>
        <CardContent className="text-sm">
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Email</span>
            <span class="font-medium">{user.email}</span>
          </div>
          <Separator className="my-3" />
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Session</span>
            <span>Signed-in cookie · 30 day sliding expiry · PBKDF2-SHA256</span>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Sending & receiving domain</CardTitle>
          <CardDescription>
            Configured as <code class="text-xs">RESEND_INBOUND_DOMAIN</code>. Mail is sent as the signed-in address
            on this domain.
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Domain</span>
            <span class="font-medium">{domain?.name ?? inboundDomain}</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Status</span>
            <Badge variant={domain?.status === 'verified' ? 'success' : 'warning'}>
              {domain?.status ?? (resendError ? 'unreachable' : 'not found')}
            </Badge>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Capabilities</span>
            <span class="flex gap-2">
              <Badge variant={sendingEnabled ? 'success' : 'warning'}>
                sending: {domain?.sending ?? 'unknown'}
              </Badge>
              <Badge variant={receivingEnabled ? 'success' : 'warning'}>
                receiving: {domain?.receiving ?? 'unknown'}
              </Badge>
            </span>
          </div>
          {domain?.region ? (
            <div class="flex items-center justify-between gap-4">
              <span class="text-muted-foreground">Region</span>
              <span>{domain.region}</span>
            </div>
          ) : null}
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Webhook</CardTitle>
          <CardDescription>All Resend events land on a single signed endpoint.</CardDescription>
        </CardHeader>
        <CardContent className="space-y-3 text-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-muted-foreground">Endpoint</span>
            <code class="bg-muted max-w-full truncate rounded px-2 py-1 text-xs">{webhookUrl}</code>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Registered in Resend</span>
            <Badge variant={webhookRegistered === null ? 'outline' : webhookRegistered ? 'success' : 'warning'}>
              {webhookRegistered === null ? 'unknown' : webhookRegistered ? 'yes' : 'no'}
            </Badge>
          </div>
          <div class="text-muted-foreground text-xs">
            Events: email.received, email.sent, email.delivered, email.delivery_delayed, email.bounced,
            email.complained, email.opened, email.clicked
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Deliverability</CardTitle>
          <CardDescription>Last 7 days, as reported by {provider.label}.</CardDescription>
        </CardHeader>
        <CardContent className="text-sm">
          {metricsError ? (
            <p class="text-muted-foreground text-xs">{metricsError}</p>
          ) : metrics && Object.keys(metrics).length > 0 ? (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {['sent', 'delivered', 'bounced', 'opened', 'clicked', 'complained'].map((key) => (
                <div>
                  <div class="text-muted-foreground text-xs capitalize">{key}</div>
                  <div class="text-lg font-semibold tabular-nums">
                    {metrics?.[key] ?? metrics?.[key.toUpperCase()] ?? 0}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-muted-foreground text-xs">No activity in the last 7 days.</p>
          )}
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Provider tools</CardTitle>
          <CardDescription>
            Webhooks and suppressions for the active {provider.label} account.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <ProviderTools client:load webhookUrl={webhookUrl} providerLabel={provider.label} />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Infrastructure</CardTitle>
          <CardDescription>Where the pieces live.</CardDescription>
        </CardHeader>
        <CardContent className="space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Turso database</span>
            <code class="text-xs">{tursoHost}</code>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Attachments (R2)</span>
            <Badge variant="success">ATTACHMENTS bucket bound</Badge>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Resend API key</span>
            <Badge variant={env.RESEND_API_KEY ? 'success' : 'warning'}>
              {env.RESEND_API_KEY ? 'configured' : 'missing'}
            </Badge>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted-foreground">Webhook secret</span>
            <Badge variant={env.RESEND_WEBHOOK_SECRET ? 'success' : 'warning'}>
              {env.RESEND_WEBHOOK_SECRET ? 'configured' : 'missing'}
            </Badge>
          </div>
        </CardContent>
      </Card>
    </div>

    <p class="text-muted-foreground mt-8 text-center text-xs">
      FLARE · Resend + Cloudflare Workers + Turso · <a class="hover:text-foreground underline" href="/">inbox</a>
    </p>
  </div>
</AppShell>
