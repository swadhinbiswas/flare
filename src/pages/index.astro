---
import AppShell from '@/layouts/AppShell.astro';
import MailClient from '@/components/mail/MailClient';
import { getFolderCounts, listThreads } from '@/lib/threads';

const user = Astro.locals.user!;
const [result, counts] = await Promise.all([listThreads({ folder: 'inbox' }), getFolderCounts()]);
---

<AppShell title="Inbox · RFLARE">
  <MailClient
    client:load
    user={user}
    folder="inbox"
    initialThreads={result.threads}
    initialNextCursor={result.nextCursor}
    initialCounts={counts}
  />
</AppShell>
