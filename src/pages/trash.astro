---
import AppShell from '@/layouts/AppShell.astro';
import MailClient from '@/components/mail/MailClient';
import { getFolderCounts, listThreads } from '@/lib/threads';
import { accountSummaries, getActiveAccount } from '@/lib/accounts';

const user = Astro.locals.user!;
const account = getActiveAccount(Astro.request.headers.get('cookie'));
const accounts = accountSummaries();
const [result, counts] = await Promise.all([listThreads({ accountId: account.id, folder: 'trash' }), getFolderCounts(account.id)]);
---

<AppShell title="Trash · RFLARE">
  <MailClient
    client:load
    user={user}
    folder="trash"
    initialThreads={result.threads}
    initialNextCursor={result.nextCursor}
    initialCounts={counts}
    accounts={accounts}
    activeAccountId={account.id}
  />
</AppShell>
