---
import AppShell from '@/layouts/AppShell.astro';
import MailClient from '@/components/mail/MailClient';
import { getFolderCounts, getThreadDetail, listThreads } from '@/lib/threads';
import { accountSummaries, getActiveAccount } from '@/lib/accounts';

const user = Astro.locals.user!;
const account = getActiveAccount(Astro.request.headers.get('cookie'));
const accounts = accountSummaries();
const id = Astro.params.id;
if (!id) return Astro.redirect('/');

const detail = await getThreadDetail(id, { markRead: true, accountId: account.id });
if (!detail) return Astro.redirect('/');

const [result, counts] = await Promise.all([listThreads({ accountId: account.id, folder: 'inbox' }), getFolderCounts(account.id)]);
---

<AppShell title={`${detail.thread.subject || 'Conversation'} · RFLARE`}>
  <MailClient
    client:load
    user={user}
    folder="inbox"
    initialThreads={result.threads}
    initialNextCursor={result.nextCursor}
    initialCounts={counts}
    accounts={accounts}
    activeAccountId={account.id}
    initialThreadId={id}
    initialThread={detail}
  />
</AppShell>
